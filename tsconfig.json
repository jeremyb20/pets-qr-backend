{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",  
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node10",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./back-end/*"],
      "@models/*": ["./back-end/models/*"],
      "@controllers/*": ["./back-end/controllers/*"],
      "@routes/*": ["./back-end/routes/*"],
      "@middlewares/*": ["./back-end/middlewares/*"],
      "@config/*": ["./back-end/config/*"],
      "@types/*": ["./back-end/types/*"],
      "@utils/*": ["./back-end/utils/*"]
    },
    "typeRoots": ["./node_modules/@types", "./back-end/types"],
    "types": ["node", "express"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "app.ts",    
    "index.ts",   
    "back-end/**/*.ts",
    "back-end/**/*.handlebars",
    "back-end/views/**/*",
    "back-end/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "services",
    "back-end/scripts/*.js",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}