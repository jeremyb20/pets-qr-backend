{
  "name": "pets-qr-backend",
  "version": "5.0.0",
  "description": "Backend para sistema de mascotas con QR - TypeScript",
  "engines": {
    "node": "20.19.6",
    "npm": "10.33.4"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc && npm run copy-views",
    "copy-views": "copyfiles -u 1 \"back-end/views/**/*\" dist/back-end",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint back-end/**/*.ts",
    "export-single": "node back-end/scripts/export-single.js",
    "export-all": "node back-end/scripts/export-all.ts",
    "migrate-data": "node back-end/scripts/migrateData-with-compass.js",
    "migrate-qrcodes": "ts-node back-end/scripts/migrateOldQRCodes.ts",
    "migrate-users-schema": "ts-node back-end/scripts/migrate-users-schema.ts",
    "migrate-qrcodes:prod": "npm run build && node dist/scripts/migrateOldQRCodes.js",
    "migrate-phone": "ts-node back-end/scripts/migrate-phone.ts",
    "migrate-pet-id": "ts-node back-end/scripts/add-memberPetId.ts",
    "update-qr-code": "ts-node back-end/scripts/update-qr-code.ts",
    "dev:js": "node index.js",
    "fly:deploy": "npm run build && fly deploy",
    "update-deps": "pnpm update",
    "audit": "pnpm audit",
    "audit-fix": "pnpm audit fix",
    "clean": "rimraf dist",
    "clean:install": "rimraf node_modules pnpm-lock.yaml && pnpm install",
    "security-check": "pnpm audit --audit-level=high"
  },
  "private": true,
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "async": "^3.2.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "emailjs": "^5.0.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-flash": "^0.0.2",
    "express-session": "^1.19.0",
    "file-saver-es": "^2.0.5",
    "fs-extra": "^11.3.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "nodemailer-express-handlebars": "^7.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.1.0",
    "qrcode": "^1.5.4",
    "rimraf": "^6.1.3",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-session": "^1.19.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.4.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "pets",
    "qr",
    "backend",
    "typescript",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "Plaquitas Para Mascotas",
  "license": "MIT"
}
