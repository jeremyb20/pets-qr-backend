{
  "name": "pets-qr-backend",
  "version": "4.0.2",
  "description": "Backend para sistema de mascotas con QR - TypeScript",
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc && npm run copy-views",
    "copy-views": "copyfiles -u 1 \"back-end/views/**/*\" dist/back-end",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint back-end/**/*.ts",
    "export-single": "node back-end/scripts/export-single.js",
    "export-all": "node back-end/scripts/export-all.ts",
    "migrate-data": "node back-end/scripts/migrateData-with-compass.js",
    "migrate-qrcodes": "ts-node back-end/scripts/migrateOldQRCodes.ts",
    "migrate-users-schema": "ts-node back-end/scripts/migrate-users-schema.ts",
    "migrate-qrcodes:prod": "npm run build && node dist/scripts/migrateOldQRCodes.js",
    "migrate-phone": "ts-node back-end/scripts/migrate-phone.ts",
    "migrate-pet-id": "ts-node back-end/scripts/add-memberPetId.ts",
    "update-qr-code": "ts-node back-end/scripts/update-qr-code.ts",
    "dev:js": "node index.js",
    "fly:deploy": "npm run build && fly deploy",
    "update-deps": "npm update",
    "audit": "npm audit",
    "audit-fix": "npm audit fix",
    "clean": "rimraf dist",
    "clean:install": "rimraf node_modules package-lock.json && npm install",
    "security-check": "npm audit --audit-level=high"
  },
  "private": true,
  "dependencies": {
    "@upstash/redis": "^1.35.4",
    "async": "^3.2.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "emailjs": "^4.0.2",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "express-flash": "^0.0.2",
    "express-session": "^1.17.3",
    "file-saver-es": "^2.0.5",
    "fs-extra": "^11.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.0-rc.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "nodemailer-express-handlebars": "^5.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^8.0.0",
    "qrcode": "^1.5.4",
    "rimraf": "^5.0.5",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/async": "^3.2.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.20",
    "@types/express-fileupload": "^1.4.4",
    "@types/express-session": "^1.17.9",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.9",
    "@types/node": "^20.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/nodemailer-express-handlebars": "^4.0.5",
    "@types/nodemon": "^1.19.6",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/web-push": "^3.6.2",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.50.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "pets",
    "qr",
    "backend",
    "typescript",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "Plaquitas Para Mascotas",
  "license": "MIT"
}
